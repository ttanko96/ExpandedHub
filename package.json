{
  "name": "expandedhub",
  "productName": "ExpandedHub",
  "version": "1.2.0",
  "description": "Desktop mod manager, updater and knowledge hub for Tekken 3 community projects",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm test && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win && node scripts/zip-setup.cjs",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "zip-setup": "node scripts/zip-setup.cjs"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "yauzl": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/rajdhani": "^5.1.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.5.8",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.1"
  },
  "author": "ExpandedHub",
  "license": "MIT",
  "build": {
    "appId": "com.expandedhub.app",
    "productName": "ExpandedHub",
    "copyright": "ExpandedHub contributors. Tekken is a trademark of Bandai Namco Entertainment.",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "registry",
        "to": "registry",
        "filter": [
          "**/*",
          "!projects/_*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ExpandedHub",
      "artifactName": "ExpandedHub-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "resources/icon.png"
    },
    "publish": null
  }
}
